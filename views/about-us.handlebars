<section class="page-title">
    <div class="color-one"></div>
    <div class="color-two"></div>
    <div class="color-three"></div>
    <div class="color-four"></div>
    <div class="auto-container">
        <h2>About us</h2>
        <ul class="bread-crumb clearfix">
            <li><a href="/"><i class="flaticon-home"></i> Home</a></li>
            <li>About us</li>
        </ul>
    </div>
    <div>
        <svg class="waves" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
            viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto">
            <defs>
                <path id="gentle-wave" d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z" />
            </defs>
            <g class="parallaxx">
                <use xlink:href="#gentle-wave" x="148" y="0" fill="rgba(255,255,255,0.7" />
                <use xlink:href="#gentle-wave" x="100" y="3" fill="rgba(255,255,255,0.5)" />
                <use xlink:href="#gentle-wave" x="70" y="5" fill="rgba(255,255,255,0.3)" />
                <use xlink:href="#gentle-wave" x="48" y="7" fill="#fff" />
            </g>
        </svg>
    </div>
</section>

<section class="about-one style-four">
    <div class="auto-container">
        <div class="about-one_icon" style="background-image:url(/assets/images/icons/icon-3.png)"></div>
        <div class="row clearfix">
            <div class="about-one_image-column col-lg-6 col-md-12 col-sm-12">
                <div class="about-one_image-outer">
                    <div class="about-one_experiance">
                        <div class="about-one_experiance-inner">
                            10+ <span>Years of <br> Experience</span>
                        </div>
                    </div>
                    <div class="about-one_image">
                        <div class="about-one_color-one"></div>
                        <div class="about-one_color-two"></div>
                        <img src="/assets/images/resource/about-1.png" alt="" />
                    </div>
                </div>
            </div>

            <div class="about-one_content-column col-lg-6 col-md-12 col-sm-12">
                <div class="about-one_content-outer">
                    <div class="sec-title">
                        <div class="sec-title_title">About iLearningHubb</div>
                        <h2 class="sec-title_heading">Building Character, Confidence, and <span>Belonging</span></h2>
                        <div class="sec-title_text">iLearningHubb creates meaningful learning journeys where children
                            grow through values-led mentoring, safe adventure, and real-life teamwork. We help families
                            raise children who are grounded in deen, socially confident, and ready to contribute.</div>
                    </div>
                    <ul class="about-one_list">
                        <li><i class="flaticon-checked"></i>Programs that combine Islamic identity, life skills, and
                            fun</li>
                        <li><i class="flaticon-checked"></i>Structured delivery from registration to post-program care
                        </li>
                        <li><i class="flaticon-checked"></i>Priority-first booking model that rewards committed families
                        </li>
                    </ul>
                    <div class="about-one_options d-flex align-items-center flex-wrap">
                        <div class="about-one_button">
                            <a href="/programs" class="theme-btn btn-style-one">
                                <span class="btn-wrap">
                                    <span class="text-one">Know more <i class="flaticon-next-1"></i></span>
                                    <span class="text-two">Know more <i class="flaticon-next-1"></i></span>
                                </span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="services-one style-two">
    <div class="outer-container">
        <div class="auto-container">
            <div class="sec-title centered">
                <div class="sec-title_title">How We Run Our Programs</div>
                <h2 class="sec-title_heading">A Conversion-Focused Journey for <br> Parents and <span>Children</span>
                </h2>
            </div>
            <div class="four-item_carousel swiper-container">
                <div class="swiper-wrapper">
                    <div class="swiper-slide">
                        <div class="service-block_one style-two">
                            <div class="service-block_one-inner">
                                <div class="service-block_one-icon"><i class="flaticon-team"></i></div>
                                <h5 class="service-block_one-title"><a href="/programs">Clear Program Path</a></h5>
                                <div class="service-block_one-text">Simple discovery, transparent details, and smooth
                                    booking flow from landing page to checkout.
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="swiper-slide">
                        <div class="service-block_one style-two">
                            <div class="service-block_one-inner">
                                <div class="service-block_one-icon"><i class="flaticon-user"></i></div>
                                <h5 class="service-block_one-title"><a href="/programs">Priority Booking Model</a></h5>
                                <div class="service-block_one-text">Advance registration secures priority over normal
                                    bookings for committed families.
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="swiper-slide">
                        <div class="service-block_one style-two">
                            <div class="service-block_one-inner">
                                <div class="service-block_one-icon"><i class="flaticon-leader"></i></div>
                                <h5 class="service-block_one-title"><a href="/programs">Mentor-Led Delivery</a></h5>
                                <div class="service-block_one-text">Trained leaders guide every group with safety,
                                    discipline, and care.
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="swiper-slide">
                        <div class="service-block_one style-two">
                            <div class="service-block_one-inner">
                                <div class="service-block_one-icon"><i class="flaticon-happiness"></i></div>
                                <h5 class="service-block_one-title"><a href="/programs">Mission-Driven Outcomes</a></h5>
                                <div class="service-block_one-text">Children return with stronger character,
                                    responsibility, and confidence.</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="four-items_carousel-pagination"></div>
            </div>
        </div>
    </div>
</section>

<section class="value-one">
    <div class="auto-container">
        <div class="row clearfix">
            <div class="value-one_content-column col-lg-6 col-md-12 col-sm-12">
                <div class="value-one_content-outer">
                    <div class="value-one_icon" style="background-image:url(/assets/images/icons/icon-4.png)"></div>
                    <div class="sec-title">
                        <div class="sec-title_title">Mission, Vision & Values</div>
                        <h2 class="sec-title_heading">Raising Better Humans for the <span>Ummah</span></h2>
                    </div>
                    <div class="value-block_one">
                        <div class="value-block_one-inner">
                            <div class="value-block_one-content">
                                <div class="value-block_one-number">01</div>
                                <h5 class="value-block_one-heading">Faith-Centred Foundation</h5>
                                <p>Every program is shaped by Islamic manners, accountability, and purpose.</p>
                            </div>
                        </div>
                    </div>
                    <div class="value-block_one">
                        <div class="value-block_one-inner">
                            <div class="value-block_one-content">
                                <div class="value-block_one-number">02</div>
                                <h5 class="value-block_one-heading">Safe, Trusted Environment</h5>
                                <p>Parents trust our systems, communication, and on-ground program structure.</p>
                            </div>
                        </div>
                    </div>
                    <div class="value-block_one">
                        <div class="value-block_one-inner">
                            <div class="value-block_one-content">
                                <div class="value-block_one-number">03</div>
                                <h5 class="value-block_one-heading">Long-Term Growth</h5>
                                <p>We focus on outcomes that stay with children beyond a single camp or trip.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="value-one_image-column col-lg-6 col-md-12 col-sm-12">
                <div class="value-one_image-outer">
                    <div class="value-one_image">
                        <img src="/assets/images/resource/value.png" alt="" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="counter-one">
    <div class="auto-container">
        <div class="inner-container" style="background-image:url(/assets/images/background/counter-bg.png)">
            <div class="row clearfix">
                <div class="counter-block_one col-xl-3 col-lg-6 col-md-6 col-sm-6">
                    <div class="counter-block_one-inner wow flipInX" data-wow-delay="0ms" data-wow-duration="1500ms">
                        <span class="counter-block_one-icon flaticon-volume"></span>
                        <div class="counter-block_one-counter"><span class="odometer" data-count="2"></span>+</div>
                        <div class="counter-block_one-text">staff-camper</div>
                    </div>
                </div>
                <div class="counter-block_one col-xl-3 col-lg-6 col-md-6 col-sm-6">
                    <div class="counter-block_one-inner wow flipInX" data-wow-delay="150ms" data-wow-duration="1500ms">
                        <span class="counter-block_one-icon flaticon-trophy"></span>
                        <div class="counter-block_one-counter">0<span class="odometer" data-count="8"></span>+</div>
                        <div class="counter-block_one-text">Prestigious Award</div>
                    </div>
                </div>
                <div class="counter-block_one col-xl-3 col-lg-6 col-md-6 col-sm-6">
                    <div class="counter-block_one-inner wow flipInX" data-wow-delay="300ms" data-wow-duration="1500ms">
                        <span class="counter-block_one-icon flaticon-mountain"></span>
                        <div class="counter-block_one-counter"><span class="odometer" data-count="13"></span>+</div>
                        <div class="counter-block_one-text">Programs Designed</div>
                    </div>
                </div>
                <div class="counter-block_one col-xl-3 col-lg-6 col-md-6 col-sm-6">
                    <div class="counter-block_one-inner wow flipInX" data-wow-delay="450ms" data-wow-duration="1500ms">
                        <span class="counter-block_one-icon flaticon-smile"></span>
                        <div class="counter-block_one-counter"><span class="odometer" data-count="100"></span>%</div>
                        <div class="counter-block_one-text">Our Commitment</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="team-two">
    <div class="outer-container">
        <div class="auto-container">
            <div class="sec-title style-three">
                <div class="d-flex justify-content-between align-items-end flex-wrap">
                    <div class="left-box">
                        <div class="sec-title_title">Meet the team</div>
                        <h2 class="sec-title_heading">Meet Our Dedicated <span>Team</span></h2>
                    </div>
                </div>
            </div>
            <div class="row clearfix">
                {{#if teamMembers.length}}
                {{#each teamMembers}}
                <div class="team-block_two col-lg-3 col-md-6 col-sm-6">
                    <div class="team-block_two-inner">
                        <div class="team-block_two-image">
                            <img src="{{#if this.imageUrlResolved}}{{this.imageUrlResolved}}{{else}}/assets/images/resource/team-4.jpg{{/if}}"
                                alt="{{this.displayName}}" />
                            <div class="team-block_two-overlay">
                                <div class="team-block_two-socials">
                                    {{#if this.socialLinks.facebook}}<a href="{{this.socialLinks.facebook}}"><i
                                            class="fa-brands fa-facebook-f"></i></a>{{/if}}
                                    {{#if this.socialLinks.twitter}}<a href="{{this.socialLinks.twitter}}"><i
                                            class="fa-brands fa-twitter"></i></a>{{/if}}
                                    {{#if this.socialLinks.linkedin}}<a href="{{this.socialLinks.linkedin}}"><i
                                            class="fa-brands fa-linkedin-in"></i></a>{{/if}}
                                </div>
                            </div>
                        </div>
                        <div class="team-block_two-content">
                            <h4 class="team-block_two-heading"><a href="javascript:void(0)">{{this.displayName}}</a></h4>
                            <div class="team-block_two-designation">{{this.displayRole}}</div>
                        </div>
                    </div>
                </div>
                {{/each}}
                {{else}}
                <div class="col-12">
                    <div class="text-muted">Team members will appear here once added from admin.</div>
                </div>
                {{/if}}
            </div>
        </div>
    </div>
</section>
