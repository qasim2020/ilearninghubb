<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <title>{{#if settings.brandName}}{{settings.brandName}}{{else}}iLearningHubb{{/if}}</title>
    <!-- Stylesheets -->
    <link href="/assets/css/bootstrap.css?v={{assetTs}}" rel="stylesheet" />
    <link href="/assets/css/style.css?v={{assetTs}}" rel="stylesheet" />
    <link href="/assets/css/meanmenu.min.css?v={{assetTs}}" rel="stylesheet" />
    <link href="/assets/css/responsive.css?v={{assetTs}}" rel="stylesheet" />

    <!-- Google Fonts - Modern Font Stack -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
        rel="stylesheet" />

    <link rel="shortcut icon" href="/assets/images/favicon.png" type="image/x-icon" />
    <link rel="icon" href="/assets/images/favicon.png" type="image/x-icon" />

    <!-- Responsive -->
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0" />

    <!--[if lt IE 9
            ]><script src="https://cdnjs.cloudflare.com/ajax/libs/html5shiv/3.7.3/html5shiv.js"></script
        ><![endif]-->
    <!--[if lt IE 9]><script src="js/respond.js"></script><![endif]-->

    <style>
        /* Modern Font Stack */
        body {
            font-family: 'Poppins', 'Inter', 'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif !important;
            background-color: #fdf3ea !important;
        }

        .page-wrapper {
            background-color: #fdf3ea !important;
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            font-family: 'Playfair Display', serif !important;
        }

        /* Custom styles for newsletter in footer */
        .newsletter-one {
            padding: 25px 50px !important;
            /* Reduced padding */
        }

        .newsletter-box {
            margin-top: 10px !important;
        }

        .newsletter-box .form-group input[type="text"],
        .newsletter-box .form-group input[type="email"] {
            height: 60px !important;
        }

        .newsletter-box .form-group .icon {
            top: 15px !important;
        }

        .newsletter-box .form-group button {
            top: 6px !important;
            padding: 14px 30px !important;
        }

        .pt-0 {
            padding-top: 0 !important;
        }

        .copyright {
            font-family: 'Playfair Display', serif !important;
        }

        .main-footer .images-outer .image-box {
            width: 92px;
            height: 92px;
            border-radius: 10px;
            overflow: hidden;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .main-footer .images-outer .image-box a {
            display: block;
            width: 100%;
            height: 100%;
        }

        .main-footer .images-outer .image-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
    </style>
</head>

<body>
    <div class="page-wrapper">
        <!-- Preloader -->
        <div class="preloader"></div>
        <!-- End Preloader -->
        {{> navbar}}

        {{> about-sidebar}}

        {{{body}}}
        <!-- Main Footer -->
        <footer class="main-footer" style="position: relative; margin-top: 150px;">
            <!-- More complex wave SVG that better matches the reference image -->
            <div class="footer-wave"
                style="position: absolute; top: -150px; left: 0; width: 100%; height: 150px; overflow: hidden;">
                <svg viewBox="0 0 1440 150" preserveAspectRatio="none" style="width: 100%; height: 100%;">
                    <path fill="#002e4d" d="M0,64 
                C180,120 300,0 480,64 
                C660,128 780,32 960,64 
                C1140,96 1260,0 1440,64 
                L1440,150 L0,150 Z">
                    </path>
                </svg>
            </div>
            <div class="color-one"></div>
            <div class="color-two"></div>
            <div class="main-footer_icon" style="
                        background-image: url(/assets/images/icons/icon-7.png);
                    "></div>

            <div class="footer-upper_box">
                <div class="auto-container">
                    <div class="newsletter-one">
                        <div class="newsletter-one_pattern" style="
                                    background-image: url(/assets/images/background/pattern-2.png);
                                "></div>
                        <div class="newsletter-one_pattern-two" style="
                                    background-image: url(/assets/images/background/pattern-3.png);
                                "></div>
                        <div class="row clearfix">
                            <div class="column col-lg-6 col-md-12 col-sm-12">
                                <div class="newsletter-one_title">NEWSLETTER</div>
                                <h2 class="newsletter-one_heading">Sign up to Our Newsletter for Latest
                                    Update</h2>
                            </div>
                            <div class="column col-lg-6 col-md-12 col-sm-12">
                                <div class="newsletter-box">
                                    <form id="subscribe-form" method="post" action="/api/subscribe">
                                        <div class="form-group">
                                            <span class="icon fa-regular fa-envelope fa-fw"></span>
                                            <input type="email" name="email" id="subscribe-email" value=""
                                                placeholder="Enter Email Here" required />
                                            <button type="submit" id="subscribe-btn" class="template-btn btn-style-one">
                                                <span class="btn-wrap">
                                                    <span class="text-one">Subscribe Now
                                                        <i class="flaticon-next-1"></i></span>
                                                    <span class="text-two">Subscribe Now
                                                        <i class="flaticon-next-1"></i></span>
                                                </span>
                                            </button>
                                        </div>
                                        <div id="subscribe-form-message" style="margin-top:8px;"></div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="widgets-section">
                <div class="auto-container">
                    <div class="row clearfix">
                        <!-- Column 1: Logo and contact info -->
                        <div class="big-column col-lg-4 col-md-12 col-sm-12">
                            <div class="footer_column">
                                <div class="footer-widget">
                                    <div class="footer-logo">
                                        <a href="/"><img src="{{#if settings.logoUrl}}{{settings.logoUrl}}{{else}}/assets/images/footer-logo.png{{/if}}" alt="{{#if settings.brandName}}{{settings.brandName}}{{else}}iLearningHubb{{/if}} Logo"
                                            title="{{#if settings.brandName}}{{settings.brandName}}{{else}}iLearningHubb{{/if}}"
                                                style="margin-left: -19px; height: 150px; object-fit: contain;" /></a>
                                    </div>
                                    <div class="footer-text">Inspiring young minds every step of the way. Building
                                        brighter futures through fun, safe, and engaging educational experiences.</div>

                                </div>
                            </div>
                        </div>

                        <!-- Column 2: Dynamic Programs + Blogs -->
                        <div class="big-column col-lg-5 col-md-12 col-sm-12">
                            <div class="row clearfix">
                                <div class="footer_column col-lg-6 col-md-6 col-sm-12">
                                    <div class="footer-widget links-widget">
                                        <h5 class="footer-title">Quick Links</h5>
                                        <ul class="footer-list">
                                            <li><a href="/">Home</a></li>
                                            <li><a href="/about-us">About Us</a></li>
                                            <li><a href="/contact-us">Contact Us</a></li>
                                            <li><a href="/faq">FAQs</a></li>
                                            <li><a href="/programs">Programs</a></li>
                                            <li><a href="/terms-and-conditions">Terms & Conditions</a></li>
                                            <li><a href="/privacy-policy">Privacy Policy</a></li>
                                            <li><a href="/cookies-policy">Cookies Policy</a></li>
                                        </ul>
                                    </div>
                                </div>

                                <div class="footer_column col-lg-6 col-md-6 col-sm-12">
                                    <div class="footer-widget links-widget">
                                        <h5 class="footer-title">Programs</h5>
                                        <ul class="footer-list">
                                            <li><a href="/programs">All Programs</a></li>
                                            {{#if footerPrograms.length}}
                                            {{#each footerPrograms}}
                                            <li><a href="/program/{{this._id}}">{{this.title}}</a></li>
                                            {{/each}}
                                            {{else}}
                                            <li><a href="/programs">Browse Programs</a></li>
                                            {{/if}}
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="big-column col-lg-3 col-md-12 col-sm-12">
                            <div class="row clearfix">
                                <div class="footer_column col-lg-12 col-md-12 col-sm-12">
                                    <div class="footer-widget links-widget">
                                        <h5 class="footer-title">Blogs</h5>
                                        <ul class="footer-list">
                                            <li><a href="/blogs">All Blogs</a></li>
                                            {{#if footerBlogs.length}}
                                            {{#each footerBlogs}}
                                            <li><a href="/blog/{{this.slug}}">{{this.title}}</a></li>
                                            {{/each}}
                                            {{else}}
                                            <li><a href="/blogs">Browse Blogs</a></li>
                                            {{/if}}
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Column 4: Theme-style Gallery + Social -->
                        <div class="big-column col-lg-12 col-md-12 col-sm-12">
                            <div class="footer_column">
                                <div class="footer-widget instagram-widget">
                                    <h5 class="footer-title">Gallery</h5>
                                    <div class="images-outer clearfix">
                                        {{#if footerGalleryImages.length}}
                                        {{#each footerGalleryImages}}
                                        <figure class="image-box">
                                            <a href="{{this.url}}" data-fslightbox="footer-gallery" data-type="image">
                                                <img src="{{this.url}}" alt="{{this.title}}">
                                            </a>
                                        </figure>
                                        {{/each}}
                                        {{else}}
                                        <figure class="image-box"><a href="/gallery"><img src="/assets/images/gallery/instagram-1.jpg" alt="Gallery"></a></figure>
                                        <figure class="image-box"><a href="/gallery"><img src="/assets/images/gallery/instagram-2.jpg" alt="Gallery"></a></figure>
                                        <figure class="image-box"><a href="/gallery"><img src="/assets/images/gallery/instagram-3.jpg" alt="Gallery"></a></figure>
                                        <figure class="image-box"><a href="/gallery"><img src="/assets/images/gallery/instagram-4.jpg" alt="Gallery"></a></figure>
                                        <figure class="image-box"><a href="/gallery"><img src="/assets/images/gallery/instagram-5.jpg" alt="Gallery"></a></figure>
                                        <figure class="image-box"><a href="/gallery"><img src="/assets/images/gallery/instagram-6.jpg" alt="Gallery"></a></figure>
                                        {{/if}}
                                    </div>
                                    <div style="margin-top: 10px;">
                                        <a href="/gallery">View full gallery <i class="flaticon-next-1"></i></a>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="footer-bottom text-center">
                <div class="auto-container">
                    <div class="copyright">Copyright &copy; 2025 iLearningHubb · All Rights Reserved</div>
                    <div class="designs_by text-center mt-3">Created with <i class="fa-solid fa-heart fa-fw"></i> by
                        Ayub & Qasim
                    </div>
                </div>
            </div>
        </footer>

        <div class="search-popup">
            <div class="color-layer"></div>
            <button class="close-search"><span class="flaticon-close"></span></button>
            <form method="post" action="blog.html">
                <div class="form-group">
                    <input type="search" name="search-field" value="" placeholder="Search Here" required="" />
                    <button class="fa fa-solid fa-magnifying-glass fa-fw" type="submit"></button>
                </div>
            </form>
        </div>
    </div>

    <div class="progress-wrap">
        <svg class="progress-circle svg-content" width="100%" height="100%" viewBox="-1 -1 102 102">
            <path d="M50,1 a49,49 0 0,1 0,98 a49,49 0 0,1 0,-98" />
        </svg>
    </div>

    <script src="/assets/js/jquery.js"></script>
    <script src="/assets/js/popper.min.js"></script>
    <script src="/assets/js/bootstrap.min.js"></script>
    <script src="/assets/js/appear.js"></script>
    <script src="/assets/js/parallax.min.js"></script>
    <script src="/assets/js/tilt.jquery.min.js"></script>
    <script src="/assets/js/jquery.paroller.min.js"></script>
    <script src="/assets/js/wow.js"></script>
    <script src="/assets/js/swiper.min.js"></script>
    <script src="/assets/js/backtotop.js"></script>
    <script src="/assets/js/odometer.js"></script>
    <script src="/assets/js/parallax-scroll.js"></script>

    <script src="/assets/js/gsap.min.js"></script>
    <script src="/assets/js/SplitText.min.js"></script>
    <script src="/assets/js/ScrollTrigger.min.js"></script>
    <script src="/assets/js/ScrollToPlugin.min.js"></script>
    <script src="/assets/js/ScrollSmoother.min.js"></script>

    <script src="/assets/js/magnific-popup.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fslightbox/index.js"></script>
    <script src="/assets/js/nav-tool.js"></script>
    <script src="/assets/js/jquery-ui.js"></script>
    <script src="/assets/js/jquery.countdown.js"></script>
    <script src="/assets/js/script.js"></script>
</body>

</html>
