<section class="page-title program-hero-dark"
    style="background-image: url('{{#if program.imageUrlResolved}}{{program.imageUrlResolved}}{{else}}/assets/images/background/contact-bg.jpg{{/if}}'); background-position: {{program.heroImagePositionX}}% {{program.heroImagePositionY}}%;">
    <div class="auto-container">
        <h1 style="color: #ffffff;">{{program.title}}</h1>
        <ul class="page-breadcrumb">
            <li><a href="/">Home</a></li>
            <li>Program</li>
        </ul>
        {{#if program.ticketingEnabled}}
        <div style="margin-top:20px; display:flex; justify-content:center;">
            <button type="button" class="theme-btn btn-style-one ticket-cta-btn" data-bs-toggle="modal" data-bs-target="#ticketCheckoutModal">
                <span class="btn-wrap">
                    <span class="text-one"><i class="fa-solid fa-ticket ticket-cta-icon"></i>Buy Ticket</span>
                    <span class="text-two"><i class="fa-solid fa-ticket ticket-cta-icon"></i>Buy Ticket</span>
                </span>
            </button>
        </div>
        {{/if}}
    </div>
</section>

<style>
    .program-hero-dark {
        position: relative;
        overflow: hidden;
    }

    .program-hero-dark::before {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.58);
    }

    .program-hero-dark .auto-container {
        position: relative;
        z-index: 1;
    }

    .program-hero-dark h1,
    .program-hero-dark .page-breadcrumb li,
    .program-hero-dark .page-breadcrumb li a {
        color: #fff !important;
    }

    .ticket-cta-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .ticket-cta-btn .btn-wrap {
        width: 100%;
    }

    .ticket-cta-btn .text-one,
    .ticket-cta-btn .text-two {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
    }

    .ticket-cta-icon {
        font-size: 20px;
        margin-right: 10px;
        line-height: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        position: relative;
        top: -1px;
    }

    .program-special-features-content ul,
    .program-special-features-content ol {
        padding-left: 1.1rem !important;
        margin: 0 0 .25rem 0 !important;
    }

    .program-special-features-content ul {
        list-style-type: disc !important;
        list-style-position: inside !important;
    }

    .program-special-features-content ol {
        list-style-type: decimal !important;
        list-style-position: inside !important;
    }

    .program-special-features-content li {
        display: list-item !important;
        margin-bottom: 0.35rem;
    }

    .tidbits-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .section-title-spaced {
        margin-bottom: 16px !important;
    }

    .section-content-spaced {
        margin-bottom: 16px;
    }

    .tidbits-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
    }

    .tidbits-label {
        font-weight: 700;
        white-space: nowrap;
    }

    .tidbits-divider {
        flex: 1;
        border-bottom: 1px solid rgba(0, 0, 0, 0.18);
        transform: translateY(-1px);
    }

    .tidbits-value {
        text-align: right;
    }
</style>

<section class="program-detail" style="padding-top: 60px; padding-bottom: 60px;">
    <div class="auto-container">
        {{#if (eq checkoutStatus "success")}}
        <div style="margin-bottom:18px; padding:12px; border-radius:8px; background:#e8f7ec; color:#175b2b;">
            Payment completed successfully.
        </div>
        {{/if}}

        {{#if (eq checkoutStatus "cancel")}}
        <div style="margin-bottom:18px; padding:12px; border-radius:8px; background:#fff4df; color:#7a4c00;">
            Checkout was cancelled. You can try again.
        </div>
        {{/if}}

        <div class="row clearfix" style="row-gap: 28px;">
            <div class="col-lg-8 col-md-12 col-sm-12 order-2 order-lg-1">
                <div class="program-detail_content">
                    {{#if program.excerpt}}
                    <p class="lead" style="margin-bottom: 18px;">{{program.excerpt}}</p>
                    {{/if}}

                    <div style="margin-bottom: 18px;">
                        {{{program.description}}}
                    </div>

                    {{#if program.ticketingEnabled}}
                    <div style="margin-top:28px; display:flex; justify-content:flex-start;">
                        <button type="button" class="theme-btn btn-style-one ticket-cta-btn" data-bs-toggle="modal"
                            data-bs-target="#ticketCheckoutModal">
                            <span class="btn-wrap">
                                <span class="text-one"><i class="fa-solid fa-ticket ticket-cta-icon"></i>Buy Ticket</span>
                                <span class="text-two"><i class="fa-solid fa-ticket ticket-cta-icon"></i>Buy Ticket</span>
                            </span>
                        </button>
                    </div>
                    {{/if}}
                </div>
            </div>

            <div class="col-lg-4 col-md-12 col-sm-12 order-1 order-lg-2">
                <aside class="program-gallery-sidebar">

                    {{#if program.specialFeatures}}
                    <div class="widget" style="margin-bottom:28px;">
                        <h5 style="margin-bottom:10px;">Overview</h5>
                        <div class="program-special-features-content" style="padding:0; margin:0;">
                            {{{program.specialFeatures}}}
                        </div>
                    </div>
                    {{/if}}

                    <div class="widget" style="margin-bottom:28px;">
                        <h5 class="section-title-spaced">Tid Bits</h5>
                        <ul class="tidbits-list section-content-spaced" style="line-height:1.6;">
                            {{#if program.duration}}
                            <li class="tidbits-row">
                                <span class="tidbits-label">Duration</span>
                                <span class="tidbits-divider"></span>
                                <span class="tidbits-value">{{capitalizeFirstLetter program.duration}}</span>
                            </li>
                            {{/if}}
                            {{#if program.ageRange}}
                            <li class="tidbits-row">
                                <span class="tidbits-label">Age Range</span>
                                <span class="tidbits-divider"></span>
                                <span class="tidbits-value">{{capitalizeFirstLetter program.ageRange}}</span>
                            </li>
                            {{/if}}
                            {{#if program.gender}}
                            <li class="tidbits-row">
                                <span class="tidbits-label">Gender</span>
                                <span class="tidbits-divider"></span>
                                <span class="tidbits-value">{{capitalizeFirstLetter program.gender}}</span>
                            </li>
                            {{/if}}
                        </ul>
                    </div>

                    {{#if program.ticketingEnabled}}
                    <div class="widget" style="margin-bottom:28px;">
                        <button type="button" class="theme-btn btn-style-one ticket-cta-btn" data-bs-toggle="modal"
                            data-bs-target="#ticketCheckoutModal" style="width:100%;">
                            <span class="btn-wrap">
                                <span class="text-one"><i class="fa-solid fa-ticket ticket-cta-icon"></i>Buy Ticket</span>
                                <span class="text-two"><i class="fa-solid fa-ticket ticket-cta-icon"></i>Buy Ticket</span>
                            </span>
                        </button>
                    </div>
                    {{/if}}

                    <div class="widget" style="margin-bottom:28px;">
                        <h5 class="section-title-spaced">Gallery</h5>
                        {{#if program.gallery.length}}
                        <div class="gallery-grid section-content-spaced"
                            style="display:grid; grid-template-columns: repeat(2, 1fr); gap:12px;">
                            {{#each program.gallery}}
                            <div style="width:100%; height:150px; overflow:hidden; border-radius:8px; position:relative;">
                                {{#if (eq this.type "video")}}
                                <a href="{{this.urlResolved}}" data-fslightbox="program-gallery" data-type="video" data-autoplay
                                    style="display:block; width:100%; height:100%; position:relative;">
                                    <img src="{{#if this.thumbnailUrlResolved}}{{this.thumbnailUrlResolved}}{{else}}/assets/images/resource/program-1.jpg{{/if}}"
                                        alt="Video thumbnail"
                                        style="width:100%; height:100%; object-fit:cover;"
                                        onerror="this.src='/assets/images/resource/program-1.jpg'" />
                                    <span
                                        style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; background:rgba(0,0,0,0.18);">
                                        <span
                                            style="width:48px; height:48px; border-radius:999px; background:rgba(0,0,0,0.72); color:#fff; display:flex; align-items:center; justify-content:center; box-shadow:0 6px 16px rgba(0,0,0,0.25);">
                                            <i class="fa-solid fa-play" style="font-size:14px; line-height:1; margin-left:2px;"></i>
                                        </span>
                                    </span>
                                </a>
                                {{else}}
                                {{#if this.supportsLightbox}}
                                <a href="{{this.urlResolved}}" data-fslightbox="program-gallery"
                                    style="display:block; width:100%; height:100%;">
                                    <img src="{{this.urlResolved}}" alt=""
                                        style="width:100%; height:100%; object-fit:cover;"
                                        onerror="this.src='/assets/images/resource/program-1.jpg'" />
                                </a>
                                {{else}}
                                <img src="{{this.urlResolved}}" alt=""
                                    style="width:100%; height:100%; object-fit:cover;"
                                    onerror="this.src='/assets/images/resource/program-1.jpg'" />
                                {{/if}}
                                {{/if}}
                            </div>
                            {{/each}}
                        </div>
                        {{else}}
                        <div class="section-content-spaced">No gallery images available.</div>
                        {{/if}}
                    </div>

                    <div class="widget" style="margin-bottom:28px;">
                        {{#if otherPrograms.length}}
                        <div style="margin-top:40px;">
                            <h4>Other Programs</h4>
                            <div class="row" style="margin-top:12px; gap:12px;">
                                {{#each otherPrograms}}
                                <div class="col-12" style="margin-bottom:16px;">
                                    <div class="program-card"
                                        style="border:1px solid #eee; padding:12px; border-radius:8px; display:flex; gap:12px; align-items:center;">
                                        <div
                                            style="width:100px; flex:0 0 100px; height:70px; overflow:hidden; border-radius:6px;">
                                            <a href="/program/{{this._id}}"><img
                                                    src="{{#if this.imageUrlResolved}}{{this.imageUrlResolved}}{{else}}/assets/images/resource/program-1.jpg{{/if}}"
                                                    alt="{{this.title}}"
                                                    style="width:100%; height:100%; object-fit:cover;" /></a>
                                        </div>
                                        <div style="flex:1;">
                                            <h5 style="margin:0 0 6px 0;"><a
                                                    href="/program/{{this._id}}">{{this.title}}</a></h5>
                                            <div style="font-size:13px; color:#666;">{{this.descriptionText}}</div>
                                        </div>
                                    </div>
                                </div>
                                {{/each}}
                            </div>
                        </div>
                        {{/if}}
                    </div>

                </aside>
            </div>
        </div>
    </div>
</section>

{{#if program.ticketingEnabled}}
<div class="modal fade" id="ticketCheckoutModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Buy Ticket</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p style="margin-bottom:8px;">
                    <strong>Price:</strong> {{program.ticketPriceDisplay}}
                </p>
                {{#if program.showConvertedPrice}}
                <p style="margin-bottom:8px;">
                    <strong>Your local price ({{program.visitorCurrency}}):</strong> {{program.convertedTicketPriceDisplay}}
                </p>
                {{/if}}
                {{#if program.seatCapacity}}
                <p style="margin-bottom:12px;">
                    <strong>Seats left:</strong> {{program.availableSeats}} / {{program.seatCapacity}}
                </p>
                {{/if}}

                {{#if program.isSoldOut}}
                <div style="padding:10px; border-radius:8px; background:#fbeaea; color:#8f1f1f;">
                    This program is currently sold out.
                </div>
                {{else}}
                <form id="programCheckoutForm">
                    <input type="hidden" id="checkoutProgramId" value="{{program._id}}">
                    <div style="margin-bottom:8px;">
                        <input type="text" id="checkoutName" class="form-control" placeholder="Full name" required>
                    </div>
                    <div style="margin-bottom:8px;">
                        <input type="email" id="checkoutEmail" class="form-control" placeholder="Email address" required>
                    </div>
                    <div style="margin-bottom:8px;">
                        <input type="text" id="checkoutPhone" class="form-control" placeholder="Phone number (optional)">
                    </div>
                    <div style="margin-bottom:12px;">
                        <label for="checkoutQuantity"><strong>Quantity</strong></label>
                        <input type="number" id="checkoutQuantity" class="form-control" value="1" min="1"
                            {{#if program.availableSeats}}max="{{program.availableSeats}}"{{/if}} required>
                    </div>
                    <button type="submit" id="checkoutButton" class="theme-btn btn-style-one ticket-cta-btn" style="width:100%;">
                        <span class="btn-wrap">
                            <span class="text-one"><i class="fa-solid fa-credit-card ticket-cta-icon"></i>Proceed to Checkout</span>
                            <span class="text-two"><i class="fa-solid fa-credit-card ticket-cta-icon"></i>Proceed to Checkout</span>
                        </span>
                    </button>
                    <p id="checkoutError" style="margin-top:10px; color:#b91c1c; display:none;"></p>
                </form>
                {{/if}}
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        const form = document.getElementById('programCheckoutForm');
        if (!form) return;

        const button = document.getElementById('checkoutButton');
        const errorBlock = document.getElementById('checkoutError');
        const originalButtonHtml = button.innerHTML;

        form.addEventListener('submit', async function (event) {
            event.preventDefault();
            errorBlock.style.display = 'none';
            errorBlock.textContent = '';

            const payload = {
                programId: document.getElementById('checkoutProgramId').value,
                name: document.getElementById('checkoutName').value.trim(),
                email: document.getElementById('checkoutEmail').value.trim(),
                phone: document.getElementById('checkoutPhone').value.trim(),
                quantity: document.getElementById('checkoutQuantity').value,
            };

            if (!payload.name || !payload.email) {
                errorBlock.textContent = 'Please provide your name and email.';
                errorBlock.style.display = 'block';
                return;
            }

            button.disabled = true;
            button.innerHTML = '<span class="btn-wrap"><span class="text-one">Creating checkout...</span><span class="text-two">Creating checkout...</span></span>';

            try {
                const response = await fetch('/api/checkout/session', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload),
                });
                const data = await response.json();

                if (!response.ok) {
                    throw new Error(data.error || 'Failed to start checkout');
                }

                if (!data.checkoutUrl) {
                    throw new Error('Checkout URL was not returned');
                }

                window.location.href = data.checkoutUrl;
            } catch (error) {
                errorBlock.textContent = error.message || 'Failed to start checkout';
                errorBlock.style.display = 'block';
                button.disabled = false;
                button.innerHTML = originalButtonHtml;
            }
        });
    })();
</script>
{{/if}}
