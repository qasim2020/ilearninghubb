<header class="main-header header-style-one">
    <div class="header-lower">
        <div class="auto-container">
            <div class="inner-container">
                <div class="d-flex justify-content-between align-items-center flex-wrap">
                    <div class="nav-outer d-flex align-items-center flex-wrap">
                        <div class="logo-box">
                            <div class="logo">
                                <a href="/">
                                    <img src="{{#if settings.logoUrl}}{{settings.logoUrl}}{{else}}/assets/images/logo-11.png{{/if}}"
                                        alt="{{#if settings.brandName}}{{settings.brandName}}{{else}}iLearningHubb{{/if}} Logo"
                                        title="{{#if settings.brandName}}{{settings.brandName}}{{else}}iLearningHubb{{/if}}"
                                        class="responsive-logo" />
                                </a>
                            </div>
                        </div>

                        <nav class="main-menu navbar-expand-md">
                            <div class="navbar-header">
                                <button class="navbar-toggler" type="button" data-toggle="collapse"
                                    data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                                    aria-expanded="false" aria-label="Toggle navigation">
                                    <span class="icon-bar"></span>
                                    <span class="icon-bar"></span>
                                    <span class="icon-bar"></span>
                                </button>
                            </div>

                            <div class="navbar-collapse collapse clearfix" id="navbarSupportedContent">
                                <ul class="navigation clearfix">
                                    <li><a href="/">Home</a></li>
                                    <li class="dropdown"><a href="#">About</a>
                                        <ul>
                                            <li><a href="/about-us">About Us</a></li>
                                            <li><a href="/faq">FAQs</a></li>
                                        </ul>
                                    </li>
                                    <li><a href="/programs">Programs</a></li>
                                    <li><a href="/gallery">Gallery</a></li>
                                    <li class="dropdown"><a href="#">Blog Posts</a>
                                        <ul>
                                            {{#each blogPosts}}
                                            <li><a
                                                    href="/blog/{{this.slug}}">{{#if this.title}}{{this.title}}{{else}}{{this.name}}{{/if}}</a>
                                            </li>
                                            {{/each}}
                                        </ul>
                                    </li>
                                    <li class="dropdown"><a href="#">Terms</a>
                                        <ul>
                                            <li><a href="/terms-and-conditions">Terms & Conditions</a></li>
                                            <li><a href="/privacy-policy">Privacy Policy</a></li>
                                            <li><a href="/cookies-policy">Cookies Policy</a></li>
                                        </ul>
                                    </li>
                                    <li><a href="/contact-us">Contact Us</a></li>
                                </ul>
                            </div>
                        </nav>
                    </div>

                    <div class="outer-box d-flex align-items-center">
                        <div class="main-header_button me-2">
                            <a class="theme-btn btn-style-one" href="/advance-tour-booking">
                                <span class="btn-wrap">
                                    <span class="text-one">Register Now</span>
                                    <span class="text-two">Register Now</span>
                                </span>
                            </a>
                        </div>

                        <div class="mobile-nav-toggler"><span class="icon flaticon-menu"></span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mobile-menu">
        <div class="menu-backdrop"></div>
        <div class="close-btn"><span class="icon flaticon-close"></span></div>

        <nav class="menu-box">
            <div class="nav-logo"><a href="/"><img
                        src="{{#if settings.logoUrl}}{{settings.logoUrl}}{{else}}/assets/images/logo-11.png{{/if}}"
                        alt="{{#if settings.brandName}}{{settings.brandName}}{{else}}iLearningHubb{{/if}} Logo"
                        title="{{#if settings.brandName}}{{settings.brandName}}{{else}}iLearningHubb{{/if}}"
                        class="responsive-mobile-logo" /></a>
            </div>
            <div class="menu-outer"></div>
        </nav>
    </div>
</header>

<style>
    .main-header {
        background-color: transparent;
        padding: 5px 0 !important;
    }

    .header-lower {
        background-color: transparent;
    }

    .main-header .main-menu .navigation>li>a {
        color: #ffffff !important;
        padding: 10px 15px !important;
    }

    .main-header .main-menu .navigation>li:hover>a {
        color: var(--secondary-color) !important;
    }

    .main-header_button .theme-btn {
        margin-left: 10px;
        padding: 12px 18px !important;
        font-size: 14px !important;
        display: flex;
        align-items: center;
        height: 100%;
    }

    .responsive-logo {
        max-width: 80px;
        height: auto;
        display: block;
    }

    .responsive-mobile-logo {
        max-width: 70px;
        height: auto;
        display: block;
        margin: 0 auto;
    }

    @media (max-width: 1200px) {

        .main-header,
        .header-lower {
            background-color: transparent;
        }

        .responsive-logo {
            max-width: 75px;
        }
    }

    @media (max-width: 1023px) {
        .main-header {
            position: absolute !important;
            background-color: transparent !important;
        }

        .main-header .header-lower {
            background-color: transparent !important;
        }

        .main-header.fixed-header .header-lower {
            background-color: transparent !important;
            box-shadow: none !important;
            animation: none !important;
            -webkit-animation: none !important;
        }
    }

    @media (max-width: 991px) {
        .main-header_button {
            display: none;
        }
    }
</style>
