<style>
    .program-hero-dark {
        position: relative;
        overflow: hidden;
    }
    .program-hero-dark::before {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.58);
    }
    .program-hero-dark .auto-container {
        position: relative;
        z-index: 1;
    }
    .program-hero-dark h1,
    .program-hero-dark .page-breadcrumb li,
    .program-hero-dark .page-breadcrumb li a {
        color: #fff !important;
    }
</style>

<section class="page-title program-hero-dark"
    style="background-image: url('{{#if blog.coverImageUrlResolved}}{{blog.coverImageUrlResolved}}{{else}}/assets/images/background/contact-bg.jpg{{/if}}');">
    <div class="auto-container">
        <h1 style="color: #ffffff;">{{blog.title}}</h1>
        <ul class="page-breadcrumb">
            <li><a href="/">Home</a></li>
            <li>Blog</li>
        </ul>
    </div>
</section>

<section class="blog-detail" style="padding-top: 60px; padding-bottom: 60px;">
    <div class="auto-container">
        <div class="row clearfix">
            <div class="col-lg-10 col-md-12 col-sm-12 offset-lg-1">
                {{#if blog.excerpt}}
                <p class="lead" style="margin-bottom: 24px;">{{blog.excerpt}}</p>
                {{/if}}

                <div class="blog-detail_content">
                    {{{blog.content}}}
                </div>

                {{#if blog.specialFeatures}}
                <div class="blog-special-features" style="margin-top:18px; padding:12px; background:#f9f9f9; border-left:4px solid var(--main-color);">
                    {{{blog.specialFeatures}}}
                </div>
                {{/if}}
            </div>
        </div>
    </div>
</section>
